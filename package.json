{
  "name": "super-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "worker": "bun src/worker.ts",
    "db:migrate": "bun src/infrastructure/database/migrate.ts",
    "db:seed": "bun src/infrastructure/database/seed.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit tests/e2e",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:e2e": "vitest run tests/e2e --no-file-parallelism",
    "test:coverage": "vitest run tests/unit --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "bullmq": "^5.61.0",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.10.0",
    "ioredis": "^5.8.0",
    "jose": "^6.1.0",
    "pino": "^10.0.0",
    "postgres": "^3.4.7",
    "prom-client": "^15.1.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.38.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
